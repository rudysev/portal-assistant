# portal-assistant (Jarvis) provisioning configuration. Read by install.sh and install.ps1.

# The assistant app to install, configure, and start.
PKG=com.portal.assistant
# Launcher Activity — Jarvis has a normal app icon; launching it also imports a staged API key.
LAUNCH_ACTIVITY=com.portal.assistant/.MainActivity
# Exported receiver used to bring the resident standby service up without a launcher tap.
RECEIVER=com.portal.assistant/.service.AssistantBootReceiver
# The one-time "come up to standby" action the installer broadcasts after install.
STANDBY_ACTION=com.portal.assistant.action.STANDBY
# Notification-listener component (gates media-session control for portal.media_control / now_playing).
NOTIF_LISTENER=com.portal.assistant/com.portal.assistant.conversation.tools.PortalNotificationListener

# Where the app stores its files. The installer stages the Gemini API key here as api_key.txt;
# Jarvis imports it on first launch and deletes the file (no typing on the Portal).
EXTDIR=/sdcard/Android/data/com.portal.assistant/files

# Where the APK comes from:
#   APK_GLOB        - a local APK to install (first match wins). Drop a built APK in apks/
#                     to install it directly instead of downloading.
#   RELEASE_REPO    - GitHub repo whose LATEST release's .apk asset is downloaded when no
#                     local APK is present.
#   RELEASE_APK_URL - pin a specific .apk URL (overrides RELEASE_REPO).
APK_GLOB=apks/*.apk
RELEASE_REPO=rudysev/portal-assistant
RELEASE_APK_URL=
